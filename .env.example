# ISEN iCal Generator - Environment Configuration

# Valkey connection URL
# Format: valkey://[:password@]host[:port][/db]
# For TLS: valkeys://[:password@]host[:port][/db]
VALKEY_URL=valkey://localhost:6379

# HTTP server port
PORT=8080

# Aurion system base URL
# This is the URL of your institution's Aurion instance
AURION_BASE_URL=https://aurion.junia.com

# Maximum number of tokens per user
# When exceeded, oldest tokens are automatically revoked
MAX_TOKENS_PER_USER=3

# Session cache TTL in seconds
# How long Aurion session data is cached
SESSION_TTL=3600

# Events cache TTL in seconds
# How long planning events are cached
CACHE_TTL=3600

# Encryption key for additional security (optional but recommended)
# Must be exactly 32 bytes (64 hex characters)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-32-byte-hex-key-here-64charslong1234567890abcdef

# Gin framework mode
# Set to 'release' for production
GIN_MODE=debug
